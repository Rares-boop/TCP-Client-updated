<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Avatar cu inițială -->
    <TextView
        android:id="@+id/txtInviteInitial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/circle_avatar_bg"
        android:gravity="center"
        android:text="A"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/txtInviteSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtInviteTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 Jul, 14:30"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Accept -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcceptInvite"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Accept"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        style="@style/Widget.MaterialComponents.Button"
        android:backgroundTint="#137fec"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="6dp" />

    <!-- Deny -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDenyInvite"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Deny"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:textColor="#94A3B8"
        android:strokeColor="#94A3B8" />

</LinearLayout>
